{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "analyze": "ANALYZE=true next build",
    "deploy": "npm run test && npm run build && vercel --prod",
    "deploy:dev": "npm run test && npm run build && vercel",
    "deploy:prod": "npm run test && npm run build && vercel --prod",
    "preview": "vercel dev",
    "vercel-build": "next build",
    "postbuild": "echo 'Build completed successfully!'",
    "images": "node scripts/image-manager.js",
    "images:populate": "node scripts/image-manager.js populate",
    "images:populate:force": "node scripts/image-manager.js populate --force",
    "images:verify": "node scripts/image-manager.js verify",
    "images:analyze": "node scripts/image-manager.js analyze",
    "test-page": "echo 'Visit http://localhost:3000/articles/test-inline-images to test inline images'"
  },
  "dependencies": {
    "@types/marked": "^5.0.2",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^16.1.2",
    "next": "15.4.6",
    "next-mdx-remote": "^5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.6",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
